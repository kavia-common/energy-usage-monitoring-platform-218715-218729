# Database (provided by energy_db container)
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000

# Security
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=10080

# CORS (comma-separated). Use "*" only for dev.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# Public site url (used for links/emails if added later)
SITE_URL=http://localhost:3000
